{
  "compilerOptions": {
    "target": "es5",
    "lib": ["dom", "dom.iterable", "es6"],
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": false,
    "forceConsistentCasingInFileNames": true,
    "module": "esnext",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": false,
    "jsx": "react-jsx",
    "declaration": true,
    "outDir": "dist",
    "rootDir": "src",
    "noImplicitAny": false
  },
  "include": [
    "src/index.ts",
    "src/lib/**/*",
    "src/types/**/*", 
    "src/util/**/*",
    "src/constants.ts",
    "src/proto-types-gen/**/*"
  ],
  "exclude": [
    "src/demo/**/*",
    "**/*.test.*",
    "**/*.spec.*",
    "src/proto-types-gen/src/google/protobuf/descriptor.ts"
  ]
}
